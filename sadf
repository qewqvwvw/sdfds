local WORKER_URL      = "https://roblox-script-sync.azazanodnl.workers.dev/"
local CLIENT_KEY      = "NBWHFhjq36rMFAGDfahg6236t43462uye%6wTY#2653TYfhd"
local HIGHLIGHT_COLOR = Color3.fromRGB(0, 255, 100)
local REAUTH_INTERVAL = 45
local LIST_INTERVAL   = 5
local DEBUG           = false
