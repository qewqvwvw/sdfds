function ScriptUsers:Log(msg)
    table.insert(self.DebugLog, os.date("%H:%M:%S") .. " " .. msg)
    while #self.DebugLog > 8 do
        table.remove(self.DebugLog, 1)
    end
    LogLabel.Text = table.concat(self.DebugLog, "\n")
end

