-- ============================================================
-- HTTP helper с таймаутом (не фризит игру)
-- ============================================================
local function httpRequest(options)
    if typeof(request) == "function" then
        return request(options)
    elseif syn and syn.request then
        return syn.request(options)
    elseif http_request then
        return http_request(options)
    elseif HttpService.RequestInternal then
        return HttpService:RequestInternal(options)
    end
    return nil
end

local function httpRequestAsync(options)
    local done = false
    local result = nil
    task.spawn(function()
        pcall(function()
            result = httpRequest(options)
        end)
        done = true
    end)
    local start = tick()
    while not done and tick() - start < HTTP_TIMEOUT do
        task.wait(0.05)
    end
    return done and result or nil
end

