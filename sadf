local Players     = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local httpRequest = (syn and syn.request)
    or (http and http.request)
    or (fluxus and fluxus.request)
    or (krnl and krnl.request)
    or (electron and electron.request)
    or request

if not httpRequest then
    warn("[SH] Нет HTTP-функции у executor'а")
    return
end

local function log(...) if DEBUG then print("[SH]", ...) end end

local function http(method, path, body)
    local opts = {
        Url = WORKER_URL .. path,
        Method = method,
        Headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"]   = "RobloxExecutor/1.0",
        },
    }
    if body then opts.Body = HttpService:JSONEncode(body) end

    local ok, res = pcall(httpRequest, opts)
    if not ok or not res then log("http err", res); return nil end

    local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not ok2 then log("json err", res.Body); return nil end
    return decoded
end

local token    = nil
local tokenExp = 0

local function fetchToken()
    local res = http("POST", "/auth", {
        userId    = LocalPlayer.UserId,
        clientKey = CLIENT_KEY,
    })
    if type(res) ~= "table" or not res.ok or not res.token then
        log("auth failed", res and res.error)
        return false
    end
    token    = res.token
    tokenExp = res.exp or 0
    log("token ok")
    return true
end

local function register()
    if not token or (os.time() * 1000) > (tokenExp - 5000) then
        if not fetchToken() then return end
    end
    local res = http("POST", "/register", { token = token })
    if type(res) == "table" and res.ok then
        log("heartbeat ok")
    else
        log("heartbeat fail", res and res.error)
        token = nil
    end
end

if not fetchToken() then
    warn("[SH] Не удалось авторизоваться на сервере")
    return
end
register()

task.spawn(function()
    while task.wait(REAUTH_INTERVAL) do
        pcall(register)
    end
end)

local highlights = {}

local function attachHighlight(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char or not char:IsDescendantOf(workspace) then return end

    if highlights[plr] and highlights[plr].Adornee == char then return end
    if highlights[plr] then pcall(function() highlights[plr]:Destroy() end) end

    local hl = Instance.new("Highlight")
    hl.Name                = "__SH_HL"
    hl.FillColor           = HIGHLIGHT_COLOR
    hl.OutlineColor        = Color3.new(1, 1, 1)
    hl.FillTransparency    = 0.55
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee             = char
    hl.Parent              = char
    highlights[plr]        = hl
end

local function detachHighlight(plr)
    if highlights[plr] then
        pcall(function() highlights[plr]:Destroy() end)
        highlights[plr] = nil
    end
end

task.spawn(function()
    while task.wait(LIST_INTERVAL) do
        local list = http("GET", "/list")
        if type(list) ~= "table" then continue end

        local active = {}
        for _, id in ipairs(list) do active[id] = true end

        for _, plr in ipairs(Players:GetPlayers()) do
            if active[plr.UserId] then
                attachHighlight(plr)
            else
                detachHighlight(plr)
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        detachHighlight(plr)
    end)
end)

Players.PlayerRemoving:Connect(detachHighlight)

LocalPlayer.CharacterAdded:Connect(function()
    for plr in pairs(highlights) do detachHighlight(plr) end
end)
