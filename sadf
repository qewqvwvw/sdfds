local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

-- ⚠️ НАСТРОЙКИ (замени на свои)
local API_URL = "https://players-tracker-kv.azazanodnl.workers.dev/"
local API_KEY = "sdgsda-sadgsmna-sgsd4sd-sd4ssdhh"

local LocalPlayer = Players.LocalPlayer
local HIGHLIGHT_NAME = "ScriptUserHighlight"

-- Отправка heartbeat (сообщаем что мы онлайн и используем скрипт)
local function sendHeartbeat()
    pcall(function()
        request({
            Url = API_URL .. "/heartbeat",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-API-Key"] = API_KEY
            },
            Body = HttpService:JSONEncode({
                userId = LocalPlayer.UserId,
                placeId = game.PlaceId,
                jobId = game.JobId
            })
        })
    end)
end

-- Очистка всех подсветок
local function clearHighlights()
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            local h = char:FindFirstChild(HIGHLIGHT_NAME)
            if h then h:Destroy() end
        end
    end
end

-- Получение списка юзеров скрипта и подсветка их
local function updateHighlights()
    local success, response = pcall(function()
        return request({
            Url = API_URL .. "/players?placeId=" .. game.PlaceId .. "&jobId=" .. game.JobId,
            Method = "GET",
            Headers = {
                ["X-API-Key"] = API_KEY
            }
        })
    end)

    if not success or response.StatusCode ~= 200 then
        return
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not ok or not data.players then
        return
    end

    clearHighlights()

    for _, userId in ipairs(data.players) do
        local player = Players:GetPlayerByUserId(userId)
        if player and player ~= LocalPlayer then
            local char = player.Character
            if char then
                local highlight = Instance.new("Highlight")
                highlight.Name = HIGHLIGHT_NAME
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = char
            end
        end
    end
end

-- Обновляем при заходе новых игроков
Players.PlayerAdded:Connect(function()
    task.wait(2)
    updateHighlights()
end)

-- Цикл heartbeat (каждые 10 сек)
spawn(function()
    while true do
        sendHeartbeat()
        wait(10)
    end
end)

-- Цикл обновления подсветок (каждые 3 сек)
spawn(function()
    while true do
        updateHighlights()
        wait(3)
    end
end)

print("[Script Tracker] Loaded successfully!")
