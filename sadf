local UPDATE_INTERVAL = 3
local HEARTBEAT_INTERVAL = 15

local function httpRequest(options)
    if typeof(request) == "function" then return request(options)
    elseif syn and syn.request then return syn.request(options)
    elseif http_request then return http_request(options)
    elseif HttpService.RequestInternal then return HttpService:RequestInternal(options)
    end
    return nil
end

local ScriptUsers = {
    Enabled = false,
    CurrentUsers = {},
    Highlights = {},
    CharConns = {},
    HighlightColor = Color3.fromRGB(0, 255, 100),
    MainLoop = nil,
    HeartbeatLoop = nil,
}

function ScriptUsers:Heartbeat()
    task.spawn(function()
        pcall(function()
            httpRequest({
                Url = WORKER_URL .. "/users",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["X-Auth-Key"] = SECRET_KEY,
                },
                Body = HttpService:JSONEncode({ userId = Player.UserId }),
            })
        end)
    end)
end

function ScriptUsers:Unregister()
    task.spawn(function()
        pcall(function()
            httpRequest({
                Url = WORKER_URL .. "/users",
                Method = "DELETE",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["X-Auth-Key"] = SECRET_KEY,
                },
                Body = HttpService:JSONEncode({ userId = Player.UserId }),
            })
        end)
    end)
end

function ScriptUsers:FetchUsers()
    task.spawn(function()
        pcall(function()
            local response = httpRequest({
                Url = WORKER_URL .. "/users",
                Method = "GET",
                Headers = { ["X-Auth-Key"] = SECRET_KEY },
            })
            if not response or not response.Body then return end
            local data = HttpService:JSONDecode(response.Body)
            if type(data) ~= "table" then return end
            local now = os.time()
            local active = {}
            for userId, timestamp in pairs(data) do
                if type(timestamp) == "number" and now - timestamp < 60 then
                    active[tostring(userId)] = timestamp
                end
            end
            self.CurrentUsers = active
        end)
    end)
end

function ScriptUsers:HighlightPlayer(player)
    if self.Highlights[player] then return end
    local function apply(char)
        if not char then return end
        local old = char:FindFirstChild("ScriptUserHighlight")
        if old then old:Destroy() end
        local hl = Instance.new("Highlight")
        hl.Name = "ScriptUserHighlight"
        hl.FillColor = self.HighlightColor
        hl.FillTransparency = 0.5
        hl.OutlineColor = self.HighlightColor
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        self.Highlights[player] = hl
    end
    apply(player.Character)
    if not self.CharConns[player] then
        self.CharConns[player] = player.CharacterAdded:Connect(function(c)
            if self.Enabled and self.CurrentUsers[tostring(player.UserId)] then
                task.wait(0.5); apply(c)
            end
        end)
    end
end

function ScriptUsers:UnhighlightPlayer(player)
    local hl = self.Highlights[player]
    if hl then hl:Destroy() end
    self.Highlights[player] = nil
    if self.CharConns[player] then
        self.CharConns[player]:Disconnect()
        self.CharConns[player] = nil
    end
end

function ScriptUsers:UpdateHighlights()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            if self.CurrentUsers[tostring(player.UserId)] then
                self:HighlightPlayer(player)
            else
                self:UnhighlightPlayer(player)
            end
        end
    end
end

function ScriptUsers:Start()
    if self.Enabled then return end
    self.Enabled = true
    self:Heartbeat()
    task.wait(0.3)
    self:FetchUsers()
    task.wait(0.3)
    self:UpdateHighlights()

    self.MainLoop = task.spawn(function()
        while self.Enabled do
            task.wait(UPDATE_INTERVAL)
            if not self.Enabled then break end
            self:FetchUsers()
            self:UpdateHighlights()
        end
    end)
    self.HeartbeatLoop = task.spawn(function()
        while self.Enabled do
            task.wait(HEARTBEAT_INTERVAL)
            if not self.Enabled then break end
            self:Heartbeat()
        end
    end)

    if not self._PlayerAdded then
        self._PlayerAdded = Players.PlayerAdded:Connect(function(p)
            task.wait(1)
            if self.Enabled then
                self:FetchUsers()
                task.wait(0.3)
                self:UpdateHighlights()
            end
        end)
        self._PlayerRemoving = Players.PlayerRemoving:Connect(function(p)
            self:UnhighlightPlayer(p)
        end)
    end
end

function ScriptUsers:Stop()
    self.Enabled = false
    if self.MainLoop then task.cancel(self.MainLoop); self.MainLoop = nil end
    if self.HeartbeatLoop then task.cancel(self.HeartbeatLoop); self.HeartbeatLoop = nil end
    for player, _ in pairs(self.Highlights) do self:UnhighlightPlayer(player) end
    self:Unregister()
end

